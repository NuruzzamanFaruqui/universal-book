# ─── Database ────────────────────────────────────────────────────────────────
# Never commit the real value. prisma.config.ts must read this, not a literal.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/universalbook

# ─── Auth (replaces Firebase) ────────────────────────────────────────────────
# Signs access tokens. Generate with: openssl rand -base64 48
# The API refuses to boot in production without it.
JWT_SECRET=

# Access-token lifetime in seconds (default 900 = 15 min).
JWT_ACCESS_TTL_SEC=900
# Refresh-token lifetime in days (default 30).
JWT_REFRESH_TTL_DAYS=30

# ─── Email ───────────────────────────────────────────────────────────────────
# Pick ONE transport. Precedence: SendGrid, then SMTP, then Resend.
# With none, emails are only logged — fine locally, a silent lockout in prod.
# All of these can also be set in Admin → API Management, which overrides env.

# Option 0: SendGrid over HTTPS. Restricted key with "Mail Send" access only.
# EMAIL_FROM must be on a domain authenticated in SendGrid (or a verified sender).
SENDGRID_API_KEY=

# Option A: any mailbox you already own (Namecheap Private Email, Workspace, …)
#   Namecheap Private Email : mail.privateemail.com : 587
#   Google Workspace/Gmail  : smtp.gmail.com        : 587  (needs an App Password)
# NOTE on Cloud Run: GCP blocks outbound port 25, and default egress usually
# blocks 465/587 too — SMTP typically needs a Serverless VPC connector with
# Cloud NAT. Resend (below) avoids the problem by using plain HTTPS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Option B: HTTPS API, so no SMTP ports involved and no VPC connector needed.
RESEND_API_KEY=

EMAIL_FROM="Universal Book <noreply@universal-book.com>"
# Base URL for every link in an email (reset, verification, notifications).
APP_URL=https://universal-book.com

# ─── Third party ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Media storage (profile photos, book covers) ─────────────────────────────
# Public bucket (see DEPLOYMENT.md). Overridable in Admin → API Management →
# Media bucket. Credentials come from Application Default Credentials: the
# Cloud Run service account in production, or locally
# `gcloud auth application-default login` / GOOGLE_APPLICATION_CREDENTIALS.
# When blank: profile photos use the default universal-book-365.appspot.com,
# and book covers are written to apps/api/uploads and served at /uploads
# (local development only — refused in production).
GCS_BUCKET=

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
